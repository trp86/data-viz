{"schema": "https://ihsn.org/schemas/timeseries/1.0.0", "schema_version": "1.0.0", "type": "timeseries", "idno": "7dae9dbd-e585-4bb8-8816-692c186423b8", "changed": "1784642051", "changed_utc": "2026-07-21T09:54:11-04:00", "created": "1731530322", "created_utc": "2024-11-13T15:38:42-05:00", "created_by": "91", "changed_by": "91", "metadata_information": {"idno": "META_FAO_CAHD_7006", "producers": [{"name": "Development Economics Data Group", "abbr": "DECDG", "affiliation": "World Bank"}], "prod_date": "2024-11-20", "version_statement": {"version_notes": "Updated title formatting for consistency.", "version_date": "2025-03-17", "version": "1.1"}, "title": "Metadata for Number of people unable to afford a healthy diet (million)"}, "series_description": {"name": "Number of people unable to afford a healthy diet (million)", "idno": "FAO_CAHD_7006", "database_id": "FAO_CAHD", "languages": [{"name": "English", "code": "EN"}], "measurement_unit": "Persons", "periodicity": "Annual", "time_periods": [{"start": "2017", "end": "2025"}], "version_statement": {"version_date": "2026-07-21"}, "topics": [{"id": "P1", "name": "Planet", "vocabulary": "WB Practice Groups"}, {"id": "P1_000001", "name": "Agriculture and Food", "parent_id": "P1", "vocabulary": "Data360 Topic L1"}, {"id": "P1_000012", "name": "Food and Nutrition Security", "parent_id": "P1_000001", "vocabulary": "Data360 Topic L2"}], "license": [{"name": "CC BY-NC-SA 3.0 IGO", "uri": "https://creativecommons.org/licenses/by-nc-sa/3.0/igo/"}], "confidentiality": "This work is made available under the Creative Commons Attribution-NonCommercial-ShareAlike 3.0 IGO license (https://creativecommons.org/licenses/by-nc-sa/3.0/igo/). In addition to this license, some database specific terms of use are listed: Terms of Use of Datasets (https://www.fao.org/contact-us/terms/db-terms-of-use/en/).", "confidentiality_note": "https://www.fao.org/contact-us/terms/db-terms-of-use/en/", "definition_long": "The unaffordability of a healthy diet is defined as the inability of a household or of an individual to pay the amount of money needed to acquire the least-cost combination of locally available foods that meets the requirement for a healthy diet, after having accounted for the portion of their income they have to reserve for acquiring all basic needs other than food. ", "relevance": "Analysed together with the indicators of the cost of a healthy diet, it measures the extent to which agrifood systems guarantee people\u2019s economic access to locally available foods in the proportions needed to conduct an active and healthy life. It helps identify actions to transform agrifood systems to improve economic access to healthy diets and promote \"nutrition-sensitive\" agriculture. It supports efforts within the framework of the Sustainable Development Goals (SDGs) to end hunger, achieve food security and improved nutrition, and promote sustainable agriculture by 2030 (SDG 2).", "definition_references": [{"source": "Food and Agriculture Organization of the United Nations (FAO)", "uri": "https://files-faostat.fao.org/production/CAHD/Description_and_metadata.xlsx"}], "methodology": "Please refer to: https://www.fao.org/faostat/en/#data/CAHD.", "aggregation_method": "Regional and global aggregates of the prevalence of unaffordability are computed as the population-weighted averages of the PUA estimated for the countries for which data are available. The number of people who cannot afford a healthy diet (NUA) is obtained by multiplying the average PUA \u2013 calculated from countries with available data \u2013 by the total population size of all countries belonging to that aggregate.", "sources": [{"name": "Cost and Affordability of a Healthy Diet (CoAHD)", "uri": "https://www.fao.org/faostat/en/#data/CAHD", "organization": "Food and Agriculture Organization of the United Nations (FAO)"}, {"uri": "https://www.worldbank.org/en/programs/icp/brief/foodpricesfornutrition", "organization": "World Bank (WB)"}], "title": "Number of people unable to afford a healthy diet (million)", "imputation": "Please refer to: https://www.fao.org/faostat/en/#data/CAHD.", "confidentiality_status": "PU", "database_name": "Cost and Affordability of a Healthy Diet (CoAHD)", "dimensions": [{"label": "Year"}, {"label": "Geographic area", "description": "Country/economy, Region"}], "ref_country": [{"name": "Serbia", "code": "SRB"}, {"name": "Seychelles", "code": "SYC"}, {"name": "Senegal", "code": "SEN"}, {"name": "Slovak Republic", "code": "SVK"}, {"name": "Sierra Leone", "code": "SLE"}, {"name": "Russian Federation", "code": "RUS"}, {"name": "Rwanda", "code": "RWA"}, {"name": "S\u00c3\u00a3o Tom\u00c3\u00a9 and Pr\u00c3\u00adncipe", "code": "STP"}, {"name": "St. Lucia", "code": "LCA"}, {"name": "Slovenia", "code": "SVN"}, {"name": "Switzerland", "code": "CHE"}, {"name": "Syrian Arab Republic", "code": "SYR"}, {"name": "Suriname", "code": "SUR"}, {"name": "Sweden", "code": "SWE"}, {"name": "Togo", "code": "TGO"}, {"name": "South Africa", "code": "ZAF"}, {"name": "South Sudan", "code": "SSD"}, {"name": "Sri Lanka", "code": "LKA"}, {"name": "Spain", "code": "ESP"}, {"name": "Nicaragua", "code": "NIC"}, {"name": "Norway", "code": "NOR"}, {"name": "Netherlands", "code": "NLD"}, {"name": "North Macedonia", "code": "MKD"}, {"name": "Niger", "code": "NER"}, {"name": "Nigeria", "code": "NGA"}, {"name": "Mozambique", "code": "MOZ"}, {"name": "Morocco", "code": "MAR"}, {"name": "Mongolia", "code": "MNG"}, {"name": "Montenegro", "code": "MNE"}, {"name": "Namibia", "code": "NAM"}, {"name": "Nepal", "code": "NPL"}, {"name": "Portugal", "code": "PRT"}, {"name": "Qatar", "code": "QAT"}, {"name": "Philippines", "code": "PHL"}, {"name": "Poland", "code": "POL"}, {"name": "Moldova", "code": "MDA"}, {"name": "Romania", "code": "ROU"}, {"name": "Korea, Rep.", "code": "KOR"}, {"name": "Pakistan", "code": "PAK"}, {"name": "West Bank and Gaza", "code": "PSE"}, {"name": "Peru", "code": "PER"}, {"name": "Paraguay", "code":